# Copy to .env and fill in. Never commit .env.

# --- Client (student side) ---
STUDENT_ID=student_001
API_URL=http://localhost:8000/attention
API_KEY=
SEND_INTERVAL=1.0

# --- Backend / database (docker compose) ---
POSTGRES_USER=attention
POSTGRES_PASSWORD=change-me
POSTGRES_DB=attentiondb
# Host port for the compose database (5433 avoids clashing with a local Postgres)
DB_PORT=5433
# API_KEY above must match the key the client sends. Leave empty to disable auth (dev only).

# --- Dashboard / scripts (connect to the compose database) ---
DATABASE_URL=postgresql://attention:change-me@localhost:5433/attentiondb

# Optional: set to upload generated PDF reports to S3 (needs AWS credentials)
S3_BUCKET=
